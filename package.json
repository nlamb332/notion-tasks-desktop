{
  "name": "notion-tasks-desktop",
  "version": "0.1.8-rc.3",
  "private": true,
  "description": "A personal Windows task app and compact widget for Notion databases",
  "author": "Notion Tasks",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preview": "node scripts/dev.mjs --preview",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:plane": "node scripts/plane-api-smoke.mjs",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:preview": "node scripts/validate-preview.mjs && npm run build && electron-builder --config electron-builder.preview.json --win nsis --x64 --publish never",
    "preview": "vite --host 127.0.0.1",
    "validate:release": "node scripts/validate-release.mjs",
    "test:desktop": "node scripts/smoke.mjs && node scripts/integration-smoke.mjs && node scripts/plane-smoke.mjs && node scripts/update-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "nlamb332",
        "repo": "notion-tasks-desktop",
        "releaseType": "release"
      }
    ],
    "appId": "com.notiontasks.desktop",
    "productName": "Notion Tasks",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Notion-Tasks-Setup-${version}.${ext}"
    }
  }
}
